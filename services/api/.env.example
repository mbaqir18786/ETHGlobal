# =============================================================================
# HEXFENCE CORE API ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port
PORT=4000

# Environment Mode: development | test | production
NODE_ENV=development

# CORS Allowed Origins (comma-separated or wildcard)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,chrome-extension://*

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Database Connection URI
# In local development, defaults to embedded file-backed storage at ./data/hexfence.db.json
DATABASE_URL=file:./data/hexfence.db.json

# Development Admin Testing Token
# IMPORTANT: Used only for development API testing. Never deploy unrestricted to production.
DEV_ADMIN_TOKEN=hexfence-dev-admin-secret-key-2026

# Arkiv Protocol Gateway Endpoint (mock/testnet)
ARKIV_GATEWAY_URL=https://gateway.arkiv.network/v1

