{
  "name": "@hexfence/api",
  "version": "0.1.0",
  "private": true,
  "description": "HexFence backend API and authentication gateway",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/docs', {recursive:true}); fs.copyFileSync('src/docs/openapi.json', 'dist/docs/openapi.json');\"",
    "test": "tsx --test test/ivr.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hexfence/arkiv": "*",
    "@hexfence/detector": "*",
    "@hexfence/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
