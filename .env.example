# ==============================================================================
# HEXFENCE — GLOBAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in local environments. NEVER commit secrets to git.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# Database (Prisma)
# ------------------------------------------------------------------------------
# For local dev SQLite: file:./dev.db
# For production PostgreSQL: postgresql://postgres:password@localhost:5432/hexfence?schema=public
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# Authentication & JWT
# ------------------------------------------------------------------------------
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string_in_production"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Blockchain & RPC Providers
# ------------------------------------------------------------------------------
# Ethereum Mainnet / Sepolia RPC endpoint
ETHEREUM_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
CHAIN_ID=11155111

# Deployer / Guard relayer private key (Only for contracts / test scripts)
DEPLOYER_PRIVATE_KEY=""
ETHERSCAN_API_KEY=""

# ------------------------------------------------------------------------------
# Arkiv Evidence Protocol
# ------------------------------------------------------------------------------
ARKIV_GATEWAY_URL="https://gateway.arkiv.network"
ARKIV_API_KEY=""
ARKIV_NAMESPACE="hexfence-evidence"

# ------------------------------------------------------------------------------
# Public API & Web Endpoints
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_EXPLORER_URL="http://localhost:3001"
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111

# ------------------------------------------------------------------------------
# Optional IVR & Urgent Voice Alert Service (Twilio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
IVR_ALERT_RECIPIENT=""
ENABLE_IVR_ALERTS=false

